{
  "name": "claude-slack-bridge-gui",
  "version": "2.0.0",
  "description": "Slack과 Claude Code 간 양방향 실시간 대화 브리지 - Electron GUI",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev:cli": "tsx watch src/index.ts",
    "dev": "vite",
    "build:cli": "tsc",
    "build": "vite build",
    "build:electron": "npm run build && electron-builder --mac",
    "start:cli": "node dist/index.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop claude-slack-bridge",
    "pm2:restart": "pm2 restart claude-slack-bridge",
    "pm2:delete": "pm2 delete claude-slack-bridge",
    "pm2:logs": "pm2 logs claude-slack-bridge",
    "pm2:monit": "pm2 monit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "slack",
    "claude",
    "mcp",
    "bridge",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.claudeslackbridge.app",
    "productName": "Claude Slack Bridge",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "files": [
      "dist-electron/**/*",
      "dist-vite/**/*",
      "build/icon.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    }
  },
  "dependencies": {
    "@slack/bolt": "^4.2.0",
    "dotenv": "^16.4.7",
    "electron-store": "^8.1.0",
    "pm2": "^6.0.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "antd": "^5.12.2",
    "concurrently": "^8.2.2",
    "date-fns": "^3.0.6",
    "electron": "^26.6.3",
    "electron-builder": "^24.9.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "uuid": "^9.0.1",
    "vite": "^5.0.10",
    "vite-plugin-electron": "^0.28.1",
    "zustand": "^4.4.7"
  }
}
